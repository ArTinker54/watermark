# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Telegram ---
# Два разных бота из @BotFather.
ADMIN_BOT_TOKEN=123456:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
STUDENT_BOT_TOKEN=654321:BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# Telegram user_id автора(ов) через запятую. Свой id можно узнать у @userinfobot.
# Всё, что придёт в admin-бот не отсюда, молча игнорируется.
ADMIN_IDS=123456789

# Опционально: id группы VSA PRO для проверки членства при регистрации.
# Бот должен быть добавлен в эту группу. Пусто — проверка выключена.
VSA_GROUP_ID=

# --- Водяной знак ---
# ДВА ЧИСЛА В ДИАПАЗОНЕ 0..4294967295. Смените их перед первым запуском
# и никогда не меняйте после: со старыми паролями метка на уже разосланных
# картинках перестанет читаться. Держите копию в надёжном месте — без них
# трассировка невозможна.
WM_PW_IMG=1234567890
WM_PW_WM=987654321

# --- Хранилище ---
# В docker-compose эти пути переопределяются на общий том /data.
DB_PATH=data/db.sqlite3
STORAGE_PATH=data/storage
OFFER_PATH=app/texts/offer.txt

# --- Поведение ---
# Сообщений в секунду при рассылке. Лимит Telegram ~30, 20 — с запасом.
BROADCAST_RATE=20
# Сколько картинок метить параллельно. Разумно: число ядер.
WM_WORKERS=4
# Порог совпадения при поиске урока на скриншоте (0..1).
TRACE_MIN_CONFIDENCE=0.35
LOG_LEVEL=INFO
